# Bu dosyayı .env olarak kopyala: cp .env.example .env
# Gerçek gizli anahtarlar asla repoya girmez.

# --- Veritabanı (docker-compose.yml ile uyumlu) ---
DATABASE_URL="postgresql://kartplan:kartplan@localhost:5432/kartplan?schema=public"

# Seed ile ADMIN rolüyle oluşturulacak e-posta (opsiyonel): pnpm --filter @kartplan/db db:seed
SEED_ADMIN_EMAIL=""

# --- Redis (rate limiting, kuyruk) ---
REDIS_URL="redis://localhost:6379"

# --- E-posta (yerelde Mailpit; arayüz: http://localhost:8025) ---
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_FROM="KartPlan <no-reply@kartplan.local>"
# Gerçek SMTP sağlayıcısı için (yerelde Mailpit'e gerek yok). Port 465 ise TLS kullanılır.
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# --- Kimlik (Auth.js) ---
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google girişi (opsiyonel; boşsa buton gizlenir). Yetkili yönlendirme URI'si:
#   {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Bildirimler (Sprint 5) ---
# Zamanlanmış işlerin anahtarı (Vercel Cron "Authorization: Bearer" ile gönderir). openssl rand -hex 32
CRON_SECRET=""
# E-postalardaki bağlantıların kökü (boşsa isteğin adresi). Üretimde: https://alan-adın
APP_URL=""

# --- Python motoru (services/engine) ---
ENGINE_URL="http://localhost:8000"
# Web ile motor arasında paylaşılan gizli anahtar. Üretmek için: openssl rand -hex 32
ENGINE_TOKEN=""

# --- Kampanya veri hattı (Sprint 2) ---
# Bankalara gönderilen User-Agent. Üretimde iletişim adresi ekle: "KartPlanBot/0.1 (+https://...; e-posta)"
PIPELINE_USER_AGENT="KartPlanBot/0.1"
# Aynı siteye istekler arası bekleme (sn); 2'nin altı kabul edilmez.
PIPELINE_MIN_DELAY_SECONDS="2"
# LLM ayıklama (ADR 0010): Claude API anahtarı (console.anthropic.com). Boşsa ayıklama çalışmaz.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-opus-5-5"

# --- Gözlemlenebilirlik (Sprint 5) ---
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
