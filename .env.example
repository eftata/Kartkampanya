# Bu dosyayı .env olarak kopyala: cp .env.example .env
# Gerçek gizli anahtarlar asla repoya girmez.

# --- Veritabanı (docker-compose.yml ile uyumlu) ---
DATABASE_URL="postgresql://kartplan:kartplan@localhost:5432/kartplan?schema=public"

# Seed ile ADMIN rolüyle oluşturulacak e-posta (opsiyonel): pnpm --filter @kartplan/db db:seed
SEED_ADMIN_EMAIL=""

# --- Redis (rate limiting, kuyruk) ---
REDIS_URL="redis://localhost:6379"

# --- E-posta (yerelde Mailpit; arayüz: http://localhost:8025) ---
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_FROM="KartPlan <no-reply@kartplan.local>"
# Gerçek SMTP sağlayıcısı için (yerelde Mailpit'e gerek yok). Port 465 ise TLS kullanılır.
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# --- Kimlik (Auth.js) ---
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google girişi (opsiyonel; boşsa buton gizlenir). Yetkili yönlendirme URI'si:
#   {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Python motoru (services/engine) ---
ENGINE_URL="http://localhost:8000"
# Web ile motor arasında paylaşılan gizli anahtar. Üretmek için: openssl rand -hex 32
ENGINE_TOKEN=""

# --- Kampanya veri hattı (Sprint 2) ---
LLM_API_KEY=""

# --- Gözlemlenebilirlik (Sprint 5) ---
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
