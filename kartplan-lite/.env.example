# Firebase web yapılandırması (Firebase konsolu → Proje ayarları → Web uygulaması).
# Firebase Hosting'e deploy edildiğinde boş bırakılabilir: uygulama /__/firebase/init.json'dan okur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 1 → yerel Firebase emülatörlerine bağlan (firebase emulators:start)
VITE_USE_EMULATORS=
