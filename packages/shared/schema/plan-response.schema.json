{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["OPTIMAL", "FEASIBLE", "FALLBACK"]
    },
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanAllocation"
      }
    },
    "campaignsHit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanCampaignHit"
      }
    },
    "nearMisses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanNearMiss"
      }
    },
    "unallocated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanUnallocated"
      }
    },
    "totalExpected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseline": {
      "$ref": "#/$defs/PlanBaseline"
    },
    "solver": {
      "$ref": "#/$defs/PlanSolver"
    }
  },
  "required": [
    "status",
    "allocations",
    "campaignsHit",
    "nearMisses",
    "unallocated",
    "totalExpected",
    "baseline",
    "solver"
  ],
  "additionalProperties": false,
  "$defs": {
    "PlanAllocation": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "card": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "campaigns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "expectedReward": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["category", "card", "amount", "campaigns", "expectedReward"],
      "additionalProperties": false
    },
    "PlanCampaignHit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tiers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reward": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["id", "tiers", "reward"],
      "additionalProperties": false
    },
    "PlanNearMiss": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "missingAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extraReward": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["id", "missingAmount", "extraReward"],
      "additionalProperties": false
    },
    "PlanUnallocated": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["category", "amount"],
      "additionalProperties": false
    },
    "PlanBaseline": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "const": "single_best_card"
        },
        "card": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["strategy", "card", "total"],
      "additionalProperties": false
    },
    "PlanSolver": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["cp-sat", "greedy"]
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["engine", "ms"],
      "additionalProperties": false
    }
  }
}
