// Şemanın tek sahibi bu dosyadır; değişiklikler yalnızca `pnpm db:migrate` ile yapılır.
// Tam taslak: docs/ROADMAP.md → "Veritabanı şeması". Modeller sprint sprint eklenir.
// Para tutarları kuruş cinsinden Int (…Kurus), oranlar baz puan Int (…Bps).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime? // Auth.js: magic link ile doğrulanınca dolar
  name           String?
  image          String? // Auth.js: Google profil fotoğrafı
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  deletedAt      DateTime? // KVKK: hesap silme talebi; 30 gün sonra kalıcı silinir
  accounts       Account[]
  sessions       Session[]
  consents       Consent[]
  cards          UserCard[]
  spend          SpendProfile[]
  notifyPrefs    Json            @default("{}")
  adminAuditLogs AdminAuditLog[]
}

enum Role {
  USER
  ADMIN
}

// Açık rıza kaydı: her onay/geri çekme yeni bir satırdır, geçmiş korunur.
model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "kvkk_aydinlatma" | "pazarlama" ...
  version   String
  granted   Boolean
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// --- Katalog (Sprint 1): banka → program → kart ürünü → sabit kazanç oranları ---
// Katalog admin tarafından yönetilir; kullanıcı yalnızca ürün seçer (kart numarası asla tutulmaz).

model Bank {
  id       String    @id @default(cuid())
  name     String    @unique
  programs Program[]
}

model Program {
  id                   String        @id @default(cuid())
  bankId               String
  bank                 Bank          @relation(fields: [bankId], references: [id])
  slug                 String        @unique // "bonus", "world" — veri hattı adaptörleri bununla eşleşir
  name                 String // Bonus, Maximum, World ...
  pointName            String // Bonus, MaxiPuan, Worldpuan
  pointValueTL         Decimal       @default(1) @db.Decimal(10, 4) // 1 puan = ? TL
  // null = puan değeri doğrulanmadı (seed tahmini); admin kaynaktan doğrulayınca tarih yazılır.
  pointValueVerifiedAt DateTime?
  cards                CardProduct[]

  @@unique([bankId, name])
}

model CardProduct {
  id              String     @id @default(cuid())
  programId       String
  program         Program    @relation(fields: [programId], references: [id])
  name            String // Bonus Platinum
  type            CardType
  annualFee       Int? // kuruş
  baseRateBps     Int        @default(0) // kampanyasız, tüm harcamalara uygulanan temel oran
  earnRates       EarnRate[] // kategoriye özel oranlar (temel oranın yerine geçer)
  // null = baseRateBps ve earnRates doğrulanmadı (seed tahmini); admin doğrulayınca tarih yazılır.
  ratesVerifiedAt DateTime?
  userCards       UserCard[]

  @@unique([programId, name])
}

enum CardType {
  CREDIT
  DEBIT
  VIRTUAL
}

// Kartın bir kategorideki kampanyasız sabit kazanç oranı (ör. akaryakıtta %1).
// Kategori için satır yoksa CardProduct.baseRateBps geçerlidir. Kart başına kategori tekildir.
model EarnRate {
  id            String      @id @default(cuid())
  cardProductId String
  cardProduct   CardProduct @relation(fields: [cardProductId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  rateBps       Int // baz puan: 50 = %0,5

  @@unique([cardProductId, categoryId])
}

model Category {
  id        String         @id @default(cuid())
  slug      String         @unique // market, akaryakit, e-ticaret
  name      String
  parentId  String?
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]     @relation("CategoryTree")
  merchants Merchant[]
  earnRates EarnRate[]
  spend     SpendProfile[]
}

model Merchant {
  id         String   @id @default(cuid())
  name       String   @unique // Migros, Opet, Trendyol
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

// --- Kullanıcı verisi (Sprint 1). Hesap silinince birlikte silinir (KVKK). ---

model UserCard {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardProductId String
  cardProduct   CardProduct @relation(fields: [cardProductId], references: [id], onDelete: Restrict)
  nickname      String?
  limitKurus    Int?
  statementDay  Int? // hesap kesim günü 1-31 (uygulama katmanında doğrulanır)
  createdAt     DateTime    @default(now())

  @@index([userId])
}

model SpendProfile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  monthlyKurus Int
  merchantIds  String[] // tercih edilen markalar (Merchant.id)

  @@unique([userId, categoryId])
}

// --- Admin işlem kaydı: kim, neyi, ne zaman değiştirdi / doğruladı (güvenlik listesi) ---
// Kayıtlar silinmez; admin hesabı silinse bile kalır (actorId boşalır, actorEmail saklanır).

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String // "bank.create", "card.update", "card.verify_rates" ...
  entityType String // "Bank" | "Program" | "CardProduct"
  entityId   String
  data       Json     @default("{}") // değişen alanlar (önce/sonra)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

// --- Auth.js (@auth/prisma-adapter) tabloları; alan adları adaptörün beklediği biçimdedir ---

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
