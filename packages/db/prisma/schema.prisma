// Şemanın tek sahibi bu dosyadır; değişiklikler yalnızca `pnpm db:migrate` ile yapılır.
// Tam taslak: docs/ROADMAP.md → "Veritabanı şeması". Modeller sprint sprint eklenir.
// Para tutarları kuruş cinsinden Int (…Kurus), oranlar baz puan Int (…Bps).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? // Auth.js: magic link ile doğrulanınca dolar
  name          String?
  image         String? // Auth.js: Google profil fotoğrafı
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? // KVKK: hesap silme talebi; 30 gün sonra kalıcı silinir
  accounts      Account[]
  sessions      Session[]
  consents      Consent[]
  notifyPrefs   Json      @default("{}")
}

enum Role {
  USER
  ADMIN
}

// Açık rıza kaydı: her onay/geri çekme yeni bir satırdır, geçmiş korunur.
model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "kvkk_aydinlatma" | "pazarlama" ...
  version   String
  granted   Boolean
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// --- Auth.js (@auth/prisma-adapter) tabloları; alan adları adaptörün beklediği biçimdedir ---

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
