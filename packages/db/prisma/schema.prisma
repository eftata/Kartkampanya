// Şemanın tek sahibi bu dosyadır; değişiklikler yalnızca `pnpm db:migrate` ile yapılır.
// Tam taslak: docs/ROADMAP.md → "Veritabanı şeması". Modeller sprint sprint eklenir.
// Para tutarları kuruş cinsinden Int (…Kurus), oranlar baz puan Int (…Bps).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  emailVerified  DateTime? // Auth.js: magic link ile doğrulanınca dolar
  name           String?
  image          String? // Auth.js: Google profil fotoğrafı
  role           Role                 @default(USER)
  createdAt      DateTime             @default(now())
  deletedAt      DateTime? // KVKK: hesap silme talebi; 30 gün sonra kalıcı silinir
  accounts       Account[]
  sessions       Session[]
  consents       Consent[]
  cards          UserCard[]
  spend          SpendProfile[]
  notifyPrefs    Json                 @default("{}")
  adminAuditLogs AdminAuditLog[]
  campaignStatus UserCampaignStatus[]
  plans          MonthlyPlan[]
}

enum Role {
  USER
  ADMIN
}

// Açık rıza kaydı: her onay/geri çekme yeni bir satırdır, geçmiş korunur.
model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "kvkk_aydinlatma" | "pazarlama" ...
  version   String
  granted   Boolean
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// --- Katalog (Sprint 1): banka → program → kart ürünü → sabit kazanç oranları ---
// Katalog admin tarafından yönetilir; kullanıcı yalnızca ürün seçer (kart numarası asla tutulmaz).

model Bank {
  id       String    @id @default(cuid())
  name     String    @unique
  programs Program[]
}

model Program {
  id                   String           @id @default(cuid())
  bankId               String
  bank                 Bank             @relation(fields: [bankId], references: [id])
  slug                 String           @unique // "bonus", "world" — veri hattı adaptörleri bununla eşleşir
  name                 String // Bonus, Maximum, World ...
  pointName            String // Bonus, MaxiPuan, Worldpuan
  pointValueTL         Decimal          @default(1) @db.Decimal(10, 4) // 1 puan = ? TL
  // null = puan değeri doğrulanmadı (seed tahmini); admin kaynaktan doğrulayınca tarih yazılır.
  pointValueVerifiedAt DateTime?
  cards                CardProduct[]
  campaigns            Campaign[]
  sources              CampaignSource[]

  @@unique([bankId, name])
}

model CardProduct {
  id              String         @id @default(cuid())
  programId       String
  program         Program        @relation(fields: [programId], references: [id])
  name            String // Bonus Platinum
  type            CardType
  annualFee       Int? // kuruş
  baseRateBps     Int            @default(0) // kampanyasız, tüm harcamalara uygulanan temel oran
  earnRates       EarnRate[] // kategoriye özel oranlar (temel oranın yerine geçer)
  // null = baseRateBps ve earnRates doğrulanmadı (seed tahmini); admin doğrulayınca tarih yazılır.
  ratesVerifiedAt DateTime?
  userCards       UserCard[]
  campaigns       CampaignCard[]

  @@unique([programId, name])
}

enum CardType {
  CREDIT
  DEBIT
  VIRTUAL
}

// Kartın bir kategorideki kampanyasız sabit kazanç oranı (ör. akaryakıtta %1).
// Kategori için satır yoksa CardProduct.baseRateBps geçerlidir. Kart başına kategori tekildir.
model EarnRate {
  id            String      @id @default(cuid())
  cardProductId String
  cardProduct   CardProduct @relation(fields: [cardProductId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  rateBps       Int // baz puan: 50 = %0,5

  @@unique([cardProductId, categoryId])
}

model Category {
  id        String         @id @default(cuid())
  slug      String         @unique // market, akaryakit, e-ticaret
  name      String
  parentId  String?
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]     @relation("CategoryTree")
  merchants Merchant[]
  earnRates EarnRate[]
  spend     SpendProfile[]
}

model Merchant {
  id         String   @id @default(cuid())
  name       String   @unique // Migros, Opet, Trendyol
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

// --- Kullanıcı verisi (Sprint 1). Hesap silinince birlikte silinir (KVKK). ---

model UserCard {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardProductId String
  cardProduct   CardProduct @relation(fields: [cardProductId], references: [id], onDelete: Restrict)
  nickname      String?
  limitKurus    Int?
  statementDay  Int? // hesap kesim günü 1-31 (uygulama katmanında doğrulanır)
  createdAt     DateTime    @default(now())

  @@index([userId])
}

model SpendProfile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  monthlyKurus Int
  merchantIds  String[] // tercih edilen markalar (Merchant.id)

  @@unique([userId, categoryId])
}

// --- Kampanyalar (Sprint 2): veri hattı DRAFT yazar, admin onaylar (APPROVED) ---
// Python veri hattı bu tablolara okur/yazar ama şemayı değiştirmez (ADR 0007).

// Bir programın kampanya listesi kaynağı; her banka adaptörü bir kayıttır.
model CampaignSource {
  id        String        @id @default(cuid())
  programId String
  program   Program       @relation(fields: [programId], references: [id])
  adapter   String        @unique // services/engine/engine/pipeline/adapters/<adapter>.py
  listUrl   String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  campaigns Campaign[]
  runs      PipelineRun[]
}

model Campaign {
  id              String               @id @default(cuid())
  programId       String
  program         Program              @relation(fields: [programId], references: [id])
  sourceId        String? // null = admin elle ekledi
  source          CampaignSource?      @relation(fields: [sourceId], references: [id])
  cardScope       CampaignCard[] // boş = programdaki tüm kartlar
  title           String
  sourceUrl       String               @unique
  rawText         String
  rawHash         String // content_hash: başlık+tarih+metin sha256; aynıysa yeniden ayıklanmaz
  summary         String[] // en fazla 3 sade madde
  startsAt        DateTime
  endsAt          DateTime
  joinMethod      JoinMethod
  joinDeadline    DateTime?
  status          CampaignStatus       @default(DRAFT)
  confidence      Float? // LLM güven skoru 0–1 (para değil)
  uncertainFields String[] // LLM'in emin olmadığı alanlar; onay kuyruğunda vurgulanır
  rules           CampaignRule[]
  userStatus      UserCampaignStatus[]
  lastSeenAt      DateTime             @default(now()) // kaynak listesinde en son görüldüğü an
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, endsAt])
  @@index([programId, status])
}

enum JoinMethod {
  AUTO
  SMS
  APP
  WEB
}

enum CampaignStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPIRED
}

// Kampanyanın geçerli olduğu kart ürünleri. Kampanyaya bağlı kart ürünü silinemez: silinseydi
// kapsam sessizce boşalıp "tüm kartlar" anlamına gelirdi.
model CampaignCard {
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cardProductId String
  cardProduct   CardProduct @relation(fields: [cardProductId], references: [id], onDelete: Restrict)

  @@id([campaignId, cardProductId])
}

model CampaignRule {
  id             String    @id @default(cuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryIds    String[] // Category.id; boş = tüm harcamalar
  merchantIds    String[] // Merchant.id; boş = kategorideki tüm markalar
  thresholdType  Threshold // SINGLE (tek seferde) | CUMULATIVE (toplam) | TXN_COUNT (işlem adedi)
  thresholdKurus Int?
  txnCount       Int?
  tierRepeat     Boolean   @default(false) // "her 2.500 TL'ye" — eşik tekrarlanır
  rewardType     Reward
  rewardKurus    Int? // sabit ödül
  rewardBps      Int? // oransal ödül
  capKurus       Int? // üst limit
  exclusions     String[] // "taksitli", "nakit_avans" ...

  @@index([campaignId])
}

enum Threshold {
  SINGLE
  CUMULATIVE
  TXN_COUNT
}

enum Reward {
  POINTS
  CASHBACK
  DISCOUNT
  INSTALLMENT
}

model PipelineRun {
  id         String            @id @default(cuid())
  sourceId   String
  source     CampaignSource    @relation(fields: [sourceId], references: [id])
  status     PipelineRunStatus @default(RUNNING)
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  found      Int               @default(0) // listede bulunan kampanya
  changed    Int               @default(0) // yeni ya da metni değişen (yeniden ayıklanan)
  errors     Json? // [{ url, message }]

  @@index([sourceId, startedAt])
}

enum PipelineRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Kullanıcının kampanyayla ilişkisi (Sprint 3): "Katıldım" işareti ve plana dahil olma.
// Satır yalnızca kullanıcı bir şey işaretleyince oluşur; yoksa ikisi de false sayılır.
// Hesap ya da kampanya silinince birlikte silinir (KVKK).
model UserCampaignStatus {
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  joined        Boolean   @default(false) // kullanıcı bankada katıldığını işaretledi
  joinedAt      DateTime?
  inPlan        Boolean   @default(false) // aylık plan bu kampanyayı kullanıyor (Sprint 4)
  progressKurus Int       @default(0) // kampanyaya sayılan harcama (Faz 2: işlem takibi)
  updatedAt     DateTime  @updatedAt

  @@id([userId, campaignId])
  @@index([campaignId])
}

// --- Admin işlem kaydı: kim, neyi, ne zaman değiştirdi / doğruladı (güvenlik listesi) ---
// Kayıtlar silinmez; admin hesabı silinse bile kalır (actorId boşalır, actorEmail saklanır).

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String // "bank.create", "card.update", "card.verify_rates" ...
  entityType String // "Bank" | "Program" | "CardProduct" | "Campaign"
  entityId   String
  data       Json     @default("{}") // değişen alanlar (önce/sonra)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

// --- Auth.js (@auth/prisma-adapter) tabloları; alan adları adaptörün beklediği biçimdedir ---

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Aylık plan (Sprint 4, ADR 0017): kullanıcı ve ay başına son hesaplanan plan. `inputHash` plan
// isteğinin kanonik özeti; aynıysa kayıtlı sonuç kullanılır, değiştiyse (kart, limit, profil,
// kampanya, katılım) yeniden hesaplanır. Tutarlar kuruş.
model MonthlyPlan {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         String // "2026-11"
  input         Json // PlanRequest
  inputHash     String // sha256(kanonik input)
  result        Json // PlanResponse
  expectedKurus Int
  baselineKurus Int
  realizedKurus Int? // Faz 2: gerçekleşen kazanç
  computedAt    DateTime
  createdAt     DateTime @default(now())

  @@unique([userId, month])
}
